# Local development environment variables.
# Copy to .env and fill in the values: cp .env.example .env

# ── Required ──────────────────────────────────────────────
# Supabase project credentials (Dashboard -> Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Hosted only: Supabase Auth IP address forwarding. Sign-in, OTP and MFA
# verification and token refreshes reach Supabase Auth from this server, so
# its per-IP rate limits would count every user behind one server IP. With
# a SECRET API key (sb_secret_..., Dashboard -> Settings -> API Keys) here,
# requests to /auth/v1 carry the end user's IP in Sb-Forwarded-For (taken
# from x-forwarded-for / x-real-ip, which Vercel sets) and use this key;
# PostgREST, Storage and Realtime requests never do. Requires the dashboard
# setting Authentication -> Rate Limits -> IP Address Forwarding. Leave
# unset for local dev and self-hosting (a client-supplied x-forwarded-for
# must not decide rate limits there); unset or not sb_secret_ means off.
# SUPABASE_SECRET_KEY=sb_secret_...

# App base URL (local dev)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Encrypts every stored personnummer (customers, employees, ROT/RUT) and the
# provider-migration snapshots. Required unless NEXT_PUBLIC_SUPABASE_URL is a
# local Supabase (localhost): without it a hosted project refuses to store or
# read one, since the built-in dev key is public and values it sealed could
# never be read with the real key. One key per database, never changed:
# openssl rand -hex 32
PERSONNUMMER_ENCRYPTION_KEY=

# Secret for authenticating cron/scheduled requests.
# Any non-empty random string for local dev: openssl rand -hex 16
CRON_SECRET=generate-a-random-secret

# Admit new SIE imports. Without NEXT_PUBLIC_SELF_HOSTED=true (hosted, and
# local dev from this file) imports are refused as "tillfälligt pausade"
# unless this is true (docs/operations/sie-import-backbone.md). A self-hosted
# install admits them
# by default and uses false to switch them off.
SIE_IMPORT_JOBS=true

# Hosted white-label only: customer-owned production domains (outside the
# hosted namespace), comma-separated. The proxy refuses to serve them from any
# backend but the production project. Never commit real customer hostnames.
# Unset on the hosted Vercel project means fail closed: every host except
# preview and local names then requires the production backend.
# PRODUCTION_CUSTOM_DOMAIN_HOSTS=app.brand-one.se,app.brand-two.se

# Receipt hunt (nightly matcher, 05:30 UTC).
# Model that settles the pairs the amount-and-merchant scoring cannot decide.
# Falls back to BEDROCK_MODEL_ID. Reading hunted mail uses the AI service's
# extraction tier instead (AI_EXTRACTION_MODEL, below).
RECEIPT_HUNT_MODEL_ID=
# Comma-separated company ids the hunt may stage proposals for. Unset means it
# runs for nobody, so enabling it is always a deliberate act rather than a side
# effect of deploying.
RECEIPT_HUNT_COMPANY_IDS=

# Receipt hunt in a connected Gmail mailbox (mail extension; the search runs
# only when a person presses the button, never from the nightly cron). A
# Google OAuth client of its own, not cloud-backup's GOOGLE_CLIENT_ID: web
# application type, the single scope gmail.readonly, and the redirect URI
# <NEXT_PUBLIC_APP_URL>/api/extensions/ext/mail/oauth/callback.
# GOOGLE_MAIL_CLIENT_ID=
# GOOGLE_MAIL_CLIENT_SECRET=
# Key for the stored mailbox grants (AES-256-GCM): 32 bytes of hex, generated
# without a trailing newline: openssl rand -hex 32 | tr -d '\n'
# Set, new grants are sealed with it (a `v2.` prefix), while grants saved
# before it keep reading with the key derived from SUPABASE_SERVICE_ROLE_KEY
# and are re-sealed with this one the next time they are used. Unset,
# everything uses the derived key, as before. A `v2.` grant is readable only
# with this exact key: removing or changing it makes those mailboxes unusable
# until it is restored (or they reconnect), and rotating the service role key
# does the same to grants not yet re-sealed.
# MAIL_TOKEN_ENCRYPTION_KEY=
# Gmail connect gate (hosted only; self-hosted installs run their own Google
# app and are never gated). Who may start a NEW Gmail consent: unset means
# nobody (the default while Google's restricted-scope review is open, so
# nobody meets Google's unverified-app screen), `*`
# means everybody (set once the scope is approved), or a comma-separated list
# of company ids. Existing connections keep
# working either way.
GOOGLE_MAIL_CONNECT_COMPANY_IDS=
# Arkiv rollout: company ids that get model reading, classification and the Arkiv UI (comma-separated, or * for all). Unset = nobody.
ARKIV_COMPANY_IDS=
# Support assistant rollout: company ids that get the AI assistant in the support dialog (comma-separated, or * for all). Unset = nobody.
# No plan gate behind it: where it is on, every member but the invoicing-only role can ask, on trial too (60 questions per user and day).
SUPPORT_ASSISTANT_COMPANY_IDS=
# How much the support assistant reasons before it answers: low, medium (default) or high; "default" sends no setting, for an assistant model that does not take one.
# SUPPORT_ASSISTANT_EFFORT=medium
# Arkiv history lanes: vision pages per company and day the backfill may spend on voucher-tied history (0 = wait for a question)
ARKIV_BACKFILL_PAGES_PER_DAY=0
# Which model tier reads history: extraction (Sonnet, default, accuracy first) or cheap (a smaller, lower-cost model)
ARKIV_HISTORY_READER_TIER=extraction

# Session timeouts are opt-in per user (user_preferences.auto_logout, toggled
# in Settings > Security): users who have not opted in stay signed in for the
# full Supabase session lifetime. The variables below set the limits that
# apply to opted-in users: 30 minutes idle, 12 hours absolute, warning 2
# minutes before expiry. Set a timeout to 0 to disable that limit entirely.
# Self-hosted deployments default both limits to 0 unless overridden.
# NEXT_PUBLIC_SESSION_TIMEOUT_FORCE_ALL=true enforces the timeouts for every
# user regardless of their preference (emergency lever / strict deployments).
# The signing key falls back to SUPABASE_SERVICE_ROLE_KEY; set a dedicated
# random secret if session signing should rotate independently.
# NEXT_PUBLIC_SESSION_IDLE_TIMEOUT_MS=1800000
# NEXT_PUBLIC_SESSION_ABSOLUTE_TIMEOUT_MS=43200000
# NEXT_PUBLIC_SESSION_WARNING_MS=120000
# NEXT_PUBLIC_SESSION_TIMEOUT_FORCE_ALL=false
# SESSION_TIMEOUT_SECRET=

# One-off system notice ("high load right now") shown once per browser to
# every signed-in user until this ISO timestamp (include the UTC offset).
# Unset or past: no banner. A new timestamp shows the banner once again.
# NEXT_PUBLIC_SYSTEM_NOTICE_UNTIL=2026-09-10T23:00:00+02:00

# Self-hosted only: set to true when public signup is turned off in your
# GoTrue/Supabase auth config (GOTRUE_DISABLE_SIGNUP / "Allow new users to
# sign up" off). GoTrue offers no clean server-side read of that setting, so
# this flag mirrors it. When true, inviting a teammate who has no account
# provisions the account server-side via the auth admin invite API (GoTrue
# must have SMTP configured to deliver that mail) instead of relying on
# public /register, which GoTrue would reject with "Signups not allowed".
# The GoTrue redirect URI allow-list (URI Allow List / GOTRUE_URI_ALLOW_LIST)
# must include /invite/* or the invite email's redirect silently falls back
# to SITE_URL.
# Hosted keeps this unset: public signup stays open there.
# AUTH_SIGNUPS_DISABLED=false

# Cloudflare Turnstile site key for Supabase Auth bot protection. This value is
# public and is embedded in the browser bundle. Leave it unset until a widget
# has been created for the deployment's exact hostnames. Deploy the site key
# before enabling Turnstile with the matching SECRET in Supabase Auth, so the
# existing login flow remains available throughout rollout.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Legal-form rollout gates. The database may store these forms while the
# picker and create paths stay closed until their complete workflows ship.
# NEXT_PUBLIC_IDEELL_FORENING_ENABLED=false
# NEXT_PUBLIC_EKONOMISK_FORENING_ENABLED=false

# Profiles on public signup. Every new
# company records the profile its legal form derives (aktiebolag: Aktiebolag
# utan anställda, enskild firma: Enskild firma, förening: Förening) as a
# suggestion that switches nothing. Set to true (or 1) to make that derived
# profile the company's profile on public signup, which hides the packages
# the profile starts with off. Unset (the default), every public signup keeps
# Standard (allt på) and sees exactly what signups see today. Existing
# companies and byrå client companies (the byrå picks in its invite form) are
# never affected.
# PROFILES_APPLY_ON_SIGNUP=false

# "Dölj <paket>?" suggestions. Set to true
# (or 1) to let the daily pending-operations cron propose hiding a package a
# company has not used for six months and that has nothing open (no unpaid
# invoice, no active employee, no asset in the register, ...). It reaches
# every existing company, Standard ones included, about a seventh of them per
# day, at most one suggestion per company per run; nothing is hidden without
# a person's yes. Unset (the default), only the event-driven suggestions run
# (Slå på Lön?, Slå på Kassa och webbshop?), and those fire only for a
# company that has the package off.
# SUGGESTIONS_HIDE_UNUSED=false

# Vendor logos (src/lib/vendor-logos). Set to true (or 1) to let the hourly
# /api/vendor-logos/cron fetch each vendor's icon once from the vendor's own
# website into the public logos bucket; the browser only ever loads it from
# there. Unset (the default), the cron answers skipped and no vendor site is
# contacted; icons already stored keep showing.
# VENDOR_LOGOS_FETCH=false

# Bank ingest skips the matchers of a switched-off package. Set to true (or 1) and every bank import
# reads the company's package switches once per batch: a package that is off
# (by the company or its profile) with nothing open in it skips its matchers
# and their reads (Kundfakturor: the customer invoice match, the ROT/RUT
# payout and payout set, the collections sweep; Leverantörsfakturor och
# betalningar: the payment order debit and the supplier invoice match). A
# package that is winding down, an unpaid invoice or a ROT/RUT begäran still
# open, keeps every matcher; a failed switch read runs them all. Unset (the
# default), every matcher runs for every company, as before. Only the switch
# decides, never the plan or the country.
# INGEST_PACKAGE_GATING=false

# Event outbox (src/lib/events/consumer-index.ts). off (the default):
# every event consumer runs inline in the emitting request and the outbox
# tables are never written. shadow: the consumers still run inline exactly
# the same, and each event is also enqueued in event_outbox for its
# consumers other than event-log; the per-minute /api/events/dispatch/cron
# marks those deliveries done without running anything. For comparing the
# two before any consumer moves to async (event_outbox_shadow_counts). Set
# it only after the 20261017120000/120100 migrations are applied.
# EVENT_OUTBOX_MODE=off

# Webhooks from the event outbox (src/lib/events/consumer-index.ts).
# inline (the default, also when unset): the webhook fan-out
# runs in the request that emits the event, as before. outbox: with
# EVENT_OUTBOX_MODE=shadow, the bus no longer fans out inline; it enqueues the
# event for the webhooks consumer as 'deferred' and /api/events/dispatch/cron
# (plus a kick right after the request) runs the fan-out, retried with
# backoff, dead after 8 attempts, idempotent per (webhook, outbox id). With
# EVENT_OUTBOX_MODE off the switch is ignored (logged once) and webhooks stay
# inline. Set it only after the 20261018110000-110300 migrations are applied.
# Switch-on check, the first hour after the redeploy:
#   select * from event_outbox_async_counts(now() - interval '1 hour')
#     where consumer_id = 'webhooks';
#   enqueued = processed + open, dead = 0, oldest_open_seconds under 120,
#   latency_p95_seconds under 60; and event_outbox_shadow_counts shows no new
#   inline_ok or inline_failed for webhooks (no instance still fans out
#   inline). Rollback: set it back to inline and redeploy; what was already
#   enqueued keeps draining. Turn EVENT_OUTBOX_MODE off only once the async
#   counts show nothing open: with the mode off nothing dispatches.
# EVENT_DELIVERY_WEBHOOKS=inline

# Grants: GRANT_SUGGESTIONS is the master switch for rules for automatic
# booking. Set to true (or 1) and
# Accounted proposes "Godkänn <motpart> automatiskt nästa gång, upp till X kr?"
# once a company has approved the same booking of a counterparty five times in
# a row, and "Godkänn <leverantör> ...?" after five identical approved invoices
# from one supplier in the inbox. Only an owner or admin accepts it, in the app
# (never their agent or a key); from then on the company's agent books that
# counterparty's next bank lines, or that supplier's next inbox invoice,
# without asking, exactly as approved and within the limit, everything
# else still waits for approval, and every such posting is listed for review
# under "Bokfört enligt regel" in Att göra. Unset or false (the default), the
# whole feature is off: nothing is proposed, no rule can be accepted, and rules
# that already exist stop applying, so every staged write waits for a person.
# Revoking and pausing rules stay possible.
# GRANT_SUGGESTIONS=false

# ── Optional: extension features (core runs without these) ─
# AI features (document extraction + AI assistant). Three ways to provide a
# backend; set one of them. AI_PROVIDER (bedrock|anthropic|openai-compatible)
# forces the choice if several are present; otherwise Bedrock wins, then the
# direct Anthropic API, then an OpenAI-compatible endpoint.
#
# 1. Claude via AWS Bedrock. Needs an AWS account with Bedrock model access to
#    Claude. Keeps inference in eu-north-1, which is what hosted runs.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=eu-north-1
#
# 2. Claude via the direct Anthropic API. No AWS account needed. Note that it
#    has no EU-residency guarantee: use Bedrock if you need one.
# ANTHROPIC_API_KEY=
#
# 3. Any OpenAI-compatible endpoint (chat-completions API), e.g. a Swedish
#    inference provider for a sovereign self-host. Document extraction and
#    single-call AI jobs run here; the in-app chat assistant does not yet.
#    A model id is required (no default exists for an arbitrary endpoint).
# AI_BASE_URL=https://api.example.se/v1
# AI_API_KEY=
# AI_MODEL=                       # default model for every tier
# AI_EXTRACTION_MODEL=            # per-tier overrides (also AI_ASSISTANT_MODEL, AI_HEAVY_MODEL);
#                                 # legacy BEDROCK_MODEL_ID / BEDROCK_SONNET_MODEL_ID /
#                                 # BEDROCK_OPUS_MODEL_ID keep working as the same overrides
# AI_VISION=true                  # openai-compatible only: set false for a text-only model
#                                 # (images/PDFs are then skipped honestly; HTML mail still extracts)
# AI_PDF_MODE=auto                # auto (Claude: native, others: rasterize with poppler) | native | rasterize
# AI_PDF_MAX_PAGES=4              # pages rasterized per PDF
# AI_PDF_RASTERIZER_BIN=pdftoppm   # poppler binary name/path (the self-host image installs poppler-utils)
# AI_STRICT_JSON=false            # openai-compatible only: response_format json_schema when the provider enforces it
# AI_EXTRACTION_MAX_TOKENS=8192   # output cap for document extraction (legacy BEDROCK_MAX_TOKENS)
# AI_CALL_TIMEOUT_SECONDS=120     # time limit of one structured answer or document reading, retries
#                                 # included; raise it for a local model that answers slowly
# AI_PROVIDER=
# The built-in assistant (chat, its build and its interview): on unless set to false, 0, off or no (MCP unaffected).
# ASSISTANT_CHAT_ENABLED=true
# Switched off, the chat stays for these companies (comma-separated ids), through the day named (YYYY-MM-DD; unset: until the list is emptied).
# ASSISTANT_CHAT_COMPANY_IDS=
# ASSISTANT_CHAT_UNTIL=
# Self-hosted connector subscription (instance side). Leave unset on hosted.
# GNUBOK_CONNECTOR_KEY=
# GNUBOK_CONNECT_URL=https://connect.accounted.se   # default; the connector service
# Bank payments (Betala via banken) go through the connector only, so they need
# a key with the payments scope. Unset: every company on a paid plan sees them.
# A comma-separated list of company ids: ONLY those (a pilot). * for everyone.
# OPENPAYMENTS_COMPANY_IDS=
# Canary: company ids (comma-separated) that use the connector for bank sync
# even while this installation has its own Enable Banking credentials. Lets an
# installation move upstream by upstream, a few companies at a time.
# CONNECT_BANK_CANARY_COMPANIES=
# Same switch for Skatteverket: listed companies send their user-token data
# calls (skattekonto, moms, AGI) through the connector's data proxy.
# CONNECT_SKV_CANARY_COMPANIES=
# Reminders, debt collection and invoice delivery through the provider a
# company activates (src/lib/collections). Runs only through the connector (the
# key needs the optional `collections` and `delivery` scopes) and is a paid
# capability. Everything below defaults to off; switching a flag off stops new
# work only: payments on cases already handed over keep being forwarded.
# COLLECTIONS_ENABLED=1                   # kill switch for new work
# COLLECTIONS_PILOT_COMPANIES=            # comma-separated company ids, or * for all
# COLLECTIONS_LADDER_ENABLED=1            # the daily candidate batch
# COLLECTIONS_DELIVERY_ENABLED=1          # delivery channels in the invoice editor
# COLLECTIONS_FAKE_ADAPTER=1              # local development only: new connections use the fake provider
# Kundförlust (befarad, konstaterad, återvunnen) on customer invoices. Off
# by default; decisions already made keep their bookkeeping either way.
# CUSTOMER_LOSS_ENABLED=1
# Kontantmetoden: book a part payment of a never-booked customer invoice pro
# rata (revenue and moms in proportion to the amount received). Off by
# default; off, such a payment is refused and booked by hand, as before.
# CASH_PARTIAL_PAYMENTS_ENABLED=1
# Accounted's own email reminders for overdue customer invoices
# (src/lib/reminders). Off until set: no batch is gathered and no
# turn-on offer shows. Each company then turns reminders on itself, and every
# day's batch waits in Att göra for approval (automatic only after three clean
# batches). Read at build time (client components import it): set, then redeploy.
# NEXT_PUBLIC_REMINDERS_SENDING_ENABLED=true
# Outbound email (invoices, reminders). Pick one provider. Resend is what
# hosted runs; SMTP is for self-hosts that want mail on their own relay.
# EMAIL_PROVIDER=resend|smtp   # optional; RESEND_API_KEY wins, else SMTP_HOST
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
# RESEND_INBOUND_DOMAIN=        # invoice-inbox extension: per-company inbox addresses are {local-part}@{this domain}
# RESEND_INBOUND_WEBHOOK_SECRET= # invoice-inbox extension: verifies the Resend inbound webhook signature
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false            # true = implicit TLS on 465, false = STARTTLS required (set SMTP_REQUIRE_TLS=false only for a plaintext LAN relay)
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM_EMAIL=
# SMTP_REQUIRE_TLS=true        # false only for a plaintext relay on a trusted LAN
# SMTP_TLS_REJECT_UNAUTHORIZED=true
# AGENT_FEEDBACK_RELAY=true       # optional: mail gnubok_feedback reports from agents to SUPPORT_RECIPIENT_EMAIL (must be set too; hosted: the support desk). Unset = reports stay in event_log only
# Bank connections (Enable Banking), own credentials. Set APP_ID and PRIVATE_KEY
# as a pair: any one of them (or a _PRODUCTION variant) switches the bank
# upstream out of connector mode. Leave all unset to route bank sync through
# GNUBOK_CONNECTOR_KEY. See docs/SELF-HOSTING.md, "Own credentials".
# ENABLE_BANKING_APP_ID=
# ENABLE_BANKING_PRIVATE_KEY=     # base64-encoded PEM (bare base64 DER also works; raw PEM does not)
# ENABLE_BANKING_API_URL=https://api.enablebanking.com   # default; api.tilisy.com = sandbox
# ENABLE_BANKING_PSU_TYPE=business
# Skatteverket API (VAT/AGI submission, skattekonto), own credentials. Setting
# either client id switches the upstream out of connector mode. Every base URL
# defaults to Skatteverket's TEST environment (test BankID only): set all five
# for production. SKATTEVERKET_ENABLED and the encryption key are needed in
# connector mode too. SKATTEVERKET_SYSTEM_* and SKATTEVERKET_OMBUD_ORG_NUMBER
# are hosted-only. See docs/SELF-HOSTING.md, "Own credentials".
# SKATTEVERKET_ENABLED=true
# SKATTEVERKET_OAUTH2_CLIENT_ID=
# SKATTEVERKET_OAUTH2_CLIENT_SECRET=
# SKATTEVERKET_APIGW_CLIENT_ID=
# SKATTEVERKET_APIGW_CLIENT_SECRET=
# SKATTEVERKET_TOKEN_ENCRYPTION_KEY=   # openssl rand -base64 32; rotating it forces every user to reconnect
# SKATTEVERKET_ENV=production          # test | production; defaults to test
# SKATTEVERKET_OAUTH_BASE_URL=https://peroauth2.skatteverket.se/oauth2/v1/per
# SKATTEVERKET_API_BASE_URL=https://api.skatteverket.se/momsdeklaration/v1
# SKATTEVERKET_AGD_INLAMNING_API_BASE_URL=https://api.skatteverket.se/arbetsgivardeklaration/inlamning/v1
# SKATTEVERKET_AGD_PERIOD_API_BASE_URL=https://api.skatteverket.se/arbetsgivardeklaration/hanteraredovisningsperiod/v1
# SKATTEVERKET_SKATTEKONTO_API_BASE_URL=https://api.skatteverket.se/beskattning/skattekonto/v2
# SKATTEVERKET_DISABLED=true           # emergency kill switch
# Zettle purchase feed (src/extensions/general/zettle): partner OAuth app from
# developer.zettle.com with redirect URI <app url>/api/extensions/zettle/callback.
# ZETTLE_CLIENT_ID=
# ZETTLE_CLIENT_SECRET=
# ZETTLE_CREDENTIALS_ENCRYPTION_KEY=   # openssl rand -base64 32; encrypts stored refresh tokens
# Digital mailboxes (src/lib/digital-mailboxes).
# Each provider and direction switches on by its credentials, for the
# companies in DIGITAL_MAILBOX_COMPANY_IDS (comma-separated company ids, or *
# for everyone; unset means nobody). Outside it, or without the credentials,
# the Inkorg lists the door as coming soon and no send channel appears.
# Both default to the provider's sandbox; *_ENVIRONMENT=production only with
# the production agreement signed. The cron /api/digital-mailboxes/cron reads
# every connected mailbox; the webhooks make it prompt.
# DIGITAL_MAILBOX_COMPANY_IDS=
# Kivra: Partner API client (reading the company's Kivra Företag inbox) and
# Tenant API client (sending invoices and payslips as the company). Kivra
# registers https://<app>/api/webhooks/kivra and shares KIVRA_WEBHOOK_SECRET.
# Receiving also needs KIVRA_ONBOARDING_URL, the partner onboarding link Kivra
# gives you (https).
# KIVRA_ENVIRONMENT=sandbox
# KIVRA_PARTNER_CLIENT_ID=
# KIVRA_PARTNER_CLIENT_SECRET=
# KIVRA_ONBOARDING_URL=
# KIVRA_CLIENT_ID=
# KIVRA_CLIENT_SECRET=
# KIVRA_WEBHOOK_SECRET=
# Billo: the partner API key (enrolling and reading the companies' Billo
# business mailboxes, bound to your partner customer at Billo) and the sender
# OAuth client (Sender API and SendEasy). BILLO_WEBHOOK_SECRET
# is a Standard Webhooks secret you choose (whsec_ + base64 of 32 random
# bytes); it is registered with Billo, together with BILLO_WEBHOOK_URL
# (https://<app>/api/webhooks/billo), the first time a mailbox is created.
# BILLO_ENVIRONMENT=sandbox
# BILLO_PARTNER_API_KEY=
# BILLO_SENDER_CLIENT_ID=
# BILLO_SENDER_CLIENT_SECRET=
# BILLO_WEBHOOK_SECRET=
# BILLO_WEBHOOK_URL=
# Peppol e-invoicing via Qvalia (certified Access Point + SMP, partner model).
# The adapter registers itself when QVALIA_API_KEY, QVALIA_PARTNER_REG_NO and
# QVALIA_BASE_URL are all set; PEPPOL_TRANSPORT_PROVIDER=qvalia switches it on
# for users. Sandbox https://api-test.qvalia.com, production https://api.qvalia.com,
# separate keys per environment. QVALIA_ACCOUNT_REG_NO defaults to the partner
# number (consolidated setup). QVALIA_WEBHOOK_SIGNING_SECRET is the HMAC
# signing secret Qvalia returns ONCE, as signingSecret, in the response to the
# first PUT /partner/{p}/webhook/configure (scripts/peppol/qvalia-probe.ts
# webhook-configure prints it); POST /partner/{p}/webhook/{id}/secret rotates
# it, with the old secret still signing for an overlap (24 h by default), so
# swap the value during the overlap. Once set, every webhook must carry a valid
# X-Qvalia-Signature (HMAC-SHA256 over "<t>.<raw body>", 5-minute window) and
# the shared-secret header below is ignored. QVALIA_WEBHOOK_SECRET is that
# legacy header value Qvalia echoes in QVALIA_WEBHOOK_HEADER (configured with
# POST /partner/{p}/webhook/{id}/auth, type api_key); it authenticates webhooks
# only while the signing secret is unset, and every such request logs that the
# signature was not verified. The key is sent bare in
# the Authorization header (what the sandbox accepts); QVALIA_AUTH_SCHEME=apikey
# switches to the "ApiKey <key>" form from the newest docs.
# PEPPOL_TRANSPORT_PROVIDER=qvalia
# Self-hosted alternative: leave every QVALIA_* variable unset and set
# GNUBOK_CONNECTOR_KEY (with the peppol scope). The instance then reaches
# Arcim's access point through the hosted connector and needs no
# PEPPOL_TRANSPORT_PROVIDER. Setting QVALIA_API_KEY or QVALIA_PARTNER_REG_NO
# switches Peppol out of connector mode. See docs/SELF-HOSTING.md.
# Cap on companies that may publish a receiving identifier through the
# provider account; over the cap the next registration is refused instead of
# exceeding it. Unset = no cap.
# PEPPOL_RECEIVING_MAX_REGISTRATIONS=10
# Morning e-mail with the last 24 hours of Peppol traffic (sends, failures,
# sends per company this month, new access requests), comma separated.
# Unset = no report. Cron: /api/peppol/daily-report/cron.
# PEPPOL_DAILY_REPORT_RECIPIENTS=ops@example.com
# Who gets the Peppol health digest (failed, stuck and unrouted documents),
# comma separated. Unset = the support address (SUPPORT_RECIPIENT_EMAIL).
# PEPPOL_ALERT_RECIPIENTS=ops@example.com
# QVALIA_API_KEY=
# QVALIA_PARTNER_REG_NO=
# QVALIA_ACCOUNT_REG_NO=
# QVALIA_BASE_URL=https://api-test.qvalia.com
# QVALIA_WEBHOOK_SIGNING_SECRET=
# QVALIA_WEBHOOK_SECRET=
# QVALIA_WEBHOOK_HEADER=x-accounted-webhook-key
# QVALIA_AUTH_SCHEME=raw

# Accounting integrations
# FORTNOX_CLIENT_ID=
# FORTNOX_CLIENT_SECRET=
# FORTNOX_REDIRECT_URI=
# Self-hosted only: which scopes YOUR Fortnox app registration carries in the
# Fortnox Developer Portal. Unset means the hosted deployment's defaults
# (documents true, assets false), which describe the hosted app, not yours.
# Set to the registration's actual state: claiming an unapproved scope makes
# Fortnox reject authorize with invalid_scope before login, and denying an
# approved one just leaves that import feature off.
# FORTNOX_DOCUMENT_SCOPES_APPROVED=true    # Arkivplats + Koppla filer (underlag import)
# FORTNOX_ASSET_SCOPES_APPROVED=false      # Anlaggningsregister (asset register import)
# Björn Lundén app credentials (OAuth2 client credentials; per-company
# User-Key is entered by the user in the migration wizard)
# BJORN_LUNDEN_CLIENT_ID=
# BJORN_LUNDEN_CLIENT_SECRET=
# Integration activation key issued by BL for the service provider. When set,
# the wizard offers "Aktivera i Lundify" (redirect flow that returns the
# User-Key itself); when unset only the manual User-Key field is shown.
# BJORN_LUNDEN_ACTIVATION_KEY=
# WhatsApp receipt intake (whatsapp-inbox extension, Meta Cloud API).
# ACCESS_TOKEN: system-user permanent token with whatsapp_business_messaging
# scope only. PHONE_NUMBER_ID: the Graph object id of the sending number.
# APP_SECRET verifies X-Hub-Signature-256 on the webhook; VERIFY_TOKEN is the
# GET-handshake shared secret you also enter in the Meta app dashboard.
# PHONE_HASH_KEY: random pepper for phone lookup hashes (openssl rand -hex 32).
# PHONE_ENCRYPTION_KEY: 32-byte hex AES-256-GCM key (openssl rand -hex 32).
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_PHONE_HASH_KEY=
# WHATSAPP_PHONE_ENCRYPTION_KEY=
# Optional: the public number as E.164 digits (e.g. 46701234567) for the
# wa.me deep link in settings. Unset = resolved from the Graph API instead.
# WHATSAPP_PUBLIC_NUMBER=
# Bolagsverket: digital inlämning av årsredovisning (bolagsverket extension).
# BOLAGSVERKET_ENV is test | accept | prod (default test) and also caps which
# environment a company may select in settings (test < accept < prod).
# Certificate material is read from env ONLY (PEM or base64-wrapped PEM):
# never from extension settings or the database.
#
# SECRET CUSTODY (prod): never keep the real mTLS private key in a plaintext
# .env file. Inject these at runtime from a secrets manager (Vercel encrypted
# env vars, AWS Secrets Manager, Vault, Doppler, …), restrict read access to
# the deploy pipeline, and rotate the client certificate/key on the cadence
# agreed with Bolagsverket (and immediately on suspected exposure). Outbound
# hosts are pinned per environment in src/extensions/general/bolagsverket/lib/
# client.ts (HOSTS): the endpoint is not configurable via env.
# BOLAGSVERKET_ENV=
# BOLAGSVERKET_CLIENT_CERT=
# BOLAGSVERKET_CLIENT_KEY=
# BOLAGSVERKET_CA=
# Safety gate: enable only after agreement, certificate, test-bank fixtures,
# acceptance testing, and production runbook approval are complete.
# BOLAGSVERKET_FILING_ENABLED=false
# NEXT_PUBLIC_BOLAGSVERKET_FILING_ENABLED=false
# BOLAGSVERKET_ARELLE_VALIDATOR_URL=
# BOLAGSVERKET_ARELLE_VALIDATOR_TOKEN=

# ── Optional: product analytics + error tracking (PostHog) ─
# Hosted only. Self-hosted deployments never load PostHog: isAnalyticsEnabled()
# (src/lib/analytics/enabled.ts) short-circuits on NEXT_PUBLIC_SELF_HOSTED=true, and
# no __NEXT_PUBLIC_POSTHOG_*__ sentinel is baked into the Docker image, so an
# operator cannot accidentally ship their users' behaviour to our project.
#
# The token is the PUBLIC project token (phc_...). It is embedded in the client
# bundle by design and is not a secret. Leave unset to run with analytics off.
# Browser traffic goes through the same-origin /rl rewrite in next.config.ts;
# NEXT_PUBLIC_POSTHOG_HOST is only used by the server-side SDK.
# NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
#
# PostHog Support identity verification. A REAL SECRET (it also authenticates
# external API requests), so no NEXT_PUBLIC_ prefix: it must never reach the
# client bundle. Only the derived per-user HMAC crosses to the browser
# (src/lib/analytics/identity-hash.ts). Unset means support tickets are scoped to
# one browser session and users recover them by email link, which is the
# normal state for local dev, CI and self-hosted.
# POSTHOG_SECRET_API_KEY=
#
# Account deletion erases the person at PostHog too (profile, events and
# session recordings: src/lib/analytics/delete-person.ts). Needs a PERSONAL API
# key with the person:write scope (a secret) and the numeric project id.
# POSTHOG_APP_HOST is the REST host, EU cloud by default. Unset: deletion
# logs a warning and the PostHog side is left to be deleted by hand.
# POSTHOG_PERSONAL_API_KEY=
# POSTHOG_PROJECT_ID=
# POSTHOG_APP_HOST=https://eu.posthog.com

# ── Optional: error tracking / observability ──────────────
# The app routes every error-level log line, and anything flagged
# `alert: true`, to a provider-agnostic sink (lib/observability). When the
# PostHog token above is set, lib/init.ts registers the PostHog adapter
# (src/lib/analytics/posthog-observability.ts) as that sink; otherwise the sink
# stays a NO-OP, the PostHog client is never constructed and nothing is ever
# sent. (The SDK is still bundled in those builds, since the imports are
# static; it simply never initialises.) The variables below are for a
# DIFFERENT vendor adapter and still change nothing on their own.
#
# Names are generic placeholders. When a provider is picked, either keep these
# and read them in the adapter, or replace them with the vendor's own names.
# OBSERVABILITY_DSN=            # server-side ingest endpoint / key
# NEXT_PUBLIC_OBSERVABILITY_DSN=  # browser ingest endpoint / key, if used
# Any adapter reading these MUST forward only post-redaction payloads
# (lib/observability/redact.ts): see docs/security/logging-and-observability.md
# Optional overrides. Both have sensible defaults: the environment falls back
# to VERCEL_ENV then NODE_ENV, and the release falls back to
# NEXT_PUBLIC_BUILD_ID (the commit sha next.config.ts inlines at build time)
# then VERCEL_GIT_COMMIT_SHA. Set them only when tagging must differ.
# OBSERVABILITY_ENVIRONMENT=
# OBSERVABILITY_RELEASE=

# Per-phase timing response headers (the auth proxy's Server-Timing on pages
# and X-Proxy-Timing on /api, the API route wrapper's Server-Timing). Off in
# production (VERCEL_ENV=production on Vercel, NODE_ENV=production anywhere
# else) because they describe the request pipeline to any caller; the same
# numbers are always in the "proxy completed" / "op completed" log lines.
# Previews and local dev send them. Set to true to send them in production
# for a debugging session, and unset it afterwards.
# EXPOSE_TIMING_HEADERS=true

# Example-data demo pages (/sandbox/wiki, /sandbox/agenter) for building and
# reviewing UI without signing in. They answer in development and on preview
# deployments; set to true to open them on this installation too.
# SANDBOX_DEMO_PAGES=true
