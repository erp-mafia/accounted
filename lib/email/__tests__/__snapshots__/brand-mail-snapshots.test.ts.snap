exports[`invoice mail (template class: invoice) > unbranded: template output unchanged and platform-free 1`] = `
"
<!DOCTYPE html>
<html lang="sv">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Faktura F-1001</title>
</head>
<body style="margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; line-height: 1.6; color: #333;">
  <div style="max-width: 600px; margin: 0 auto; padding: 40px 20px;">
    <!-- Header -->
    <div style="margin-bottom: 30px; border-bottom: 2px solid #1a1a1a; padding-bottom: 16px;">
      <h1 style="margin: 0 0 10px 0; font-size: 24px; font-weight: 600; color: #1a1a1a;">
        Faktura från Kund AB
      </h1>
      <p style="margin: 0; color: #666; font-size: 14px;">
        Fakturanummer: F-1001
      </p>
    </div>

    <!-- Greeting -->
    <div style="margin-bottom: 30px;">
      <p style="margin: 0 0 15px 0;">
        Hej Erik,
      </p>
      <p style="margin: 0;">
        Tack för ditt förtroende! Bifogat hittar du din faktura.
      </p>
    </div>

    <!-- Summary Box -->
    <div style="background: #f8f9fa; border-radius: 8px; padding: 25px; margin-bottom: 30px;">
      <table style="width: 100%; border-collapse: collapse;">
        <tr>
          <td style="padding: 8px 0; color: #666; font-size: 14px;">Fakturanummer:</td>
          <td style="padding: 8px 0; text-align: right; font-weight: 500;">F-1001</td>
        </tr>
        <tr>
          <td style="padding: 8px 0; color: #666; font-size: 14px;">Fakturadatum:</td>
          <td style="padding: 8px 0; text-align: right;">2026-07-01</td>
        </tr>
        <tr>
          <td style="padding: 8px 0; color: #666; font-size: 14px;">Förfallodatum:</td>
          <td style="padding: 8px 0; text-align: right; font-weight: 500; color: #e11d48;">
            2026-07-31
          </td>
        </tr>
        <tr>
          <td colspan="2" style="padding: 15px 0 8px 0; border-top: 1px solid #e5e7eb;"></td>
        </tr>
        <tr>
          <td style="padding: 8px 0; font-size: 18px; font-weight: 600;">Att betala:</td>
          <td style="padding: 8px 0; text-align: right; font-size: 18px; font-weight: 600; color: #1a1a1a;">
            1 250,00 SEK
          </td>
        </tr>
      </table>
    </div>

    <!-- Pay-online button: only when the user pasted a payment link on this
         invoice. The URL is schema-validated (https-only) but still escaped
         for the attribute context: a URL may legally contain quotes. -->
    

    <!-- Payment Details -->
    
    <div style="margin-bottom: 30px;">
      <h2 style="margin: 0 0 15px 0; font-size: 16px; font-weight: 600; color: #1a1a1a;">
        Betalningsinformation
      </h2>
      <table style="width: 100%; border-collapse: collapse;">
        
        
        
        
        <tr>
          <td style="padding: 6px 0; color: #666; font-size: 14px;">Meddelande:</td>
          <td style="padding: 6px 0; font-weight: 500;">F-1001</td>
        </tr>
      </table>
    </div>
    

    <!-- Footer -->
    <div style="margin-top: 30px; padding-top: 20px; border-top: 1px solid #e5e7eb;">
      <p style="margin: 0 0 10px 0; color: #666; font-size: 14px;">
        Har du frågor om fakturan? Svara direkt på detta mejl så hjälper vi dig.
      </p>
      <p style="margin: 0; color: #666; font-size: 14px;">
        Med vänliga hälsningar,<br>
        <strong style="color: #1a1a1a;">Kund AB</strong>
      </p>
      
      <p style="margin: 10px 0 0 0; color: #999; font-size: 12px;">
        Org.nr: 556000-0000
        
         | Innehar F-skattsedel
      </p>
      
    </div>
  </div>
</body>
</html>
"
`;

exports[`payslip mail (template class: payslip) > branded: brand sender and brand-domain link 1`] = `
"<p>Hej Anna,</p>
<p>Din lönespecifikation för juni 2026 finns att hämta via länken nedan.</p>
<p><a href="https://app.siffra.se/payslip/tok-1">Visa lönespecifikation</a></p>
<p>Utbetalningsdag: 2026-06-25<br>
Länken är personlig och giltig i 90 dagar.</p>
<p>Med vänliga hälsningar,<br>Kund AB</p>"
`;

