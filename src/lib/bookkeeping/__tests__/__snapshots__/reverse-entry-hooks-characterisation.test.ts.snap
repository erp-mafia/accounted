// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`correctEntry: runs no reversal hook (characterisation) > invoice_paid 1`] = `
[
  "read journal_entries (*, lines:journal_entry_lines(*))",
  "assertStornoTarget",
  "insert journal_entries reverses_id=entry-1 source_type=storno status=draft",
  "insert journal_entry_lines x2",
  "rpc commit_journal_entry",
  "insert journal_entries correction_of_id=entry-1 source_type=correction status=draft",
  "insert journal_entry_lines x2",
  "rpc commit_journal_entry",
  "update journal_entries reversed_by_id=reversal-1 status=reversed",
  "update transactions journal_entry_id=corrected-1",
  "update transaction_voucher_links journal_entry_id=corrected-1",
  "update invoice_payments journal_entry_id=corrected-1",
  "update supplier_invoice_payments journal_entry_id=corrected-1",
  "update supplier_invoices payment_journal_entry_id=corrected-1",
  "rpc relink_documents_to_correction",
  "read journal_entries (*, lines:journal_entry_lines(*))",
  "read journal_entries (*, lines:journal_entry_lines(*))",
  "emit journal_entry.committed",
  "emit journal_entry.committed",
  "emit journal_entry.corrected",
]
`;

